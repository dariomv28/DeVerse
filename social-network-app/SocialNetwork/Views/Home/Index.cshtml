@using Microsoft.AspNetCore.Http;
@using SocialNetwork.Core.Application.Dtos.Account
@using SocialNetwork.Core.Application.Helpers;
@using SocialNetwork.Core.Application.ViewModels.Comment
@using SocialNetwork.Core.Application.ViewModels.Post
@using SocialNetwork.Core.Application.ViewModels.Message
@using SocialNetwork.Core.Application.ViewModels.Friend

@inject IHttpContextAccessor httpContextAccessor;
@model SavePostViewModel

@{
    ViewData["Title"] = "Home page";

    var User = httpContextAccessor.HttpContext.Session.Get<AuthenticationResponse>("user");
    bool editMode = Model.Id == 0 ? false : true;

    List<PostViewModel> posts = ViewBag.Posts;
    List<FriendViewModel> friends = ViewBag.Friends;
}

<div class="container-fluid">
    <div class="row">

        <!-- LEFT: HOME / POSTS -->
        <div class="col-9">
            <div class="row">
                <div class="col-8 offset-2">
                    <div class="card card-box-shadow mt-3">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-auto">
                                    <a asp-controller="Profile"
                                       asp-action="Index"
                                       asp-route-id="@User.Id">
                                        <img src="@(string.IsNullOrEmpty(User.ProfilePicture) ? "/Images/Users/default-user.png" : User.ProfilePicture)"
                                             class="rounded-circle"
                                             alt="Foto del usuario @User.Username"
                                             style="width: 50px; height: 50px; margin-right: 10px;">
                                    </a>
                                </div>

                                <div class="col">
                                    <button type="button"
                                            class="btn btn-secondary-custom w-100"
                                            data-bs-toggle="modal"
                                            data-bs-target="#exampleModal">
                                        <span class="d-flex justify-content-start">
                                            What's on your mind? @User.Username
                                        </span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Create Post -->
            <div class="modal fade" id="exampleModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content card-box-shadow">
                        <div class="modal-header">
                            <h1 class="modal-title fs-5">Create post</h1>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>

                        <div class="modal-body">
                            <form method="post"
                                  enctype="multipart/form-data"
                                  asp-controller="Post"
                                  asp-action="@(editMode ? "Edit" : "CreatePost")">

                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                                <input type="hidden" asp-for="Id" />
                                <input type="hidden" asp-for="Created" />
                                <input type="hidden" asp-for="SharedPostId" />

                                <div class="mb-3">
                                    <textarea asp-for="Content"
                                              class="form-control"
                                              placeholder="What's on your mind?"></textarea>
                                    <span asp-validation-for="Content" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="File" class="form-label"></label>
                                    <input asp-for="File" class="form-control" />
                                    <span asp-validation-for="File" class="text-danger"></span>
                                </div>

                                <div class="pt-1">
                                    <button class="btn btn-primary w-100">Post</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Posts -->
            <div class="row">
                <partial name="_PostCards" model="posts" />
            </div>
        </div>

        <!-- RIGHT: MESSAGES -->
        <div class="col-3">
            <div class="card card-box-shadow mt-3 position-sticky" style="top: 20px;">
                <div class="card-header bg-white">
                    <h4 class="mb-0">Messages</h4>
                </div>

                <div class="card-body">
                    @if (friends != null && friends.Count > 0)
                    {
                        foreach (FriendViewModel friend in friends)
                        {
                            <button type="button"
                                    class="btn btn-outline-primary w-100 mb-2 text-start"
                                    onclick="openChat('@friend.Id', '@friend.Username')">
                                @friend.Username
                            </button>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No friends to message</p>
                    }
                </div>
            </div>

            <div class="card card-box-shadow mt-3" id="chatBox" style="display:none;">
                <div class="card-header bg-white">
                    <h5 id="chatTitle" class="mb-0">Chat</h5>
                </div>

                <div class="card-body" id="messagesBox" style="height:300px; overflow-y:auto;">
                </div>

                <div class="card-footer bg-white">
                    <input type="hidden" id="receiverId" />
                    <input type="hidden" id="receiverName" />

                    <div class="input-group">
                        <input type="text"
                               id="messageContent"
                               class="form-control"
                               placeholder="Type message..." />

                        <button type="button"
                                class="btn btn-primary"
                                onclick="sendMessage()">
                            Send
                        </button>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    <script>
        $(document).ready(function () {
            var editMode = @Html.Raw(editMode.ToString().ToLower());

            if (editMode) {
                $('#exampleModal').modal('show');
            }
        });

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .build();

        connection.on("ReceiveMessage", function (message) {

            const receiverId = document.getElementById("receiverId").value;

            if (
                message.senderId !== receiverId &&
                message.receiverId !== receiverId
            ) {
                return;
            }

            appendMessage(
                message.content,
                message.receiverId === receiverId,
                message.created
            );
        });

        connection.start()
            .then(function () {
                console.log("SignalR connected");
            })
            .catch(function (err) {
                console.error("SignalR connection error:", err.toString());
            });

        function openChat(friendId, username) {

            document.getElementById("chatBox").style.display = "block";
            document.getElementById("receiverId").value = friendId;
            document.getElementById("receiverName").value = username;
            document.getElementById("chatTitle").innerText =
                "Chat with " + username;

            fetch(`/Home/GetConversation?friendId=${friendId}`)
                .then(response => response.json())
                .then(messages => {

                    const box = document.getElementById("messagesBox");

                    box.innerHTML = "";

                    messages.forEach(message => {

                        appendMessage(
                            message.content,
                            message.isMine,
                            message.created
                        );

                    });

                    box.scrollTop = box.scrollHeight;
                })
                .catch(function (err) {
                    console.error("Get conversation error:", err);
                });
        }

        function sendMessage() {

            const receiverId = document.getElementById("receiverId").value;
            const contentInput = document.getElementById("messageContent");
            const content = contentInput.value;

            if (!receiverId || !content.trim()) {
                return;
            }

            connection.invoke("SendMessage", receiverId, content)
                .catch(function (err) {
                    console.error("Send message error:", err.toString());
                });

            contentInput.value = "";
        }

        function appendMessage(content, isMine, created) {
            const box = document.getElementById("messagesBox");
            const div = document.createElement("div");

            let createdText = "";

            if (created) {
                const date = new Date(created);
                createdText = date.toLocaleString("vi-VN");
            }

            if (isMine) {
                div.className = "text-end mb-2";
                div.innerHTML = `
                    <span class="badge bg-primary p-2">${content}</span>
                    <br/>
                    <small class="text-muted">${createdText}</small>
                `;
            } else {
                div.className = "text-start mb-2";
                div.innerHTML = `
                    <span class="badge bg-secondary p-2">${content}</span>
                    <br/>
                    <small class="text-muted">${createdText}</small>
                `;
            }

            box.appendChild(div);
            box.scrollTop = box.scrollHeight;
        }
    </script>
}
